# Only used by the optional TestFlight workflow (.github/workflows/testflight.yml).
default_platform(:ios)

platform :ios do
  desc "Sign the app with a distribution certificate and upload it to TestFlight"
  lane :testflight_upload do
    setup_ci
    import_certificate(
      certificate_path: ENV["CERT_PATH"],
      certificate_password: ENV["P12_PASSWORD"],
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )
    install_provisioning_profile(path: ENV["PROFILE_PATH"])
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV["TEAM_ID"],
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["PROFILE_NAME"],
      bundle_identifier: ENV["BUNDLE_ID"]
    )
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "APP_BUNDLE_ID=#{ENV['BUNDLE_ID']}",
      export_options: { provisioningProfiles: { ENV["BUNDLE_ID"] => ENV["PROFILE_NAME"] } }
    )
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_BASE64"],
      is_key_content_base64: true
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
